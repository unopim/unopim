# =============================================================================
# UnoPim Docker Environment — development stack (compose.dev.yaml)
# =============================================================================
# Quick start:
#   1. cp .env.docker .env
#   2. docker compose -f compose.dev.yaml up -d
#   3. First boot installs Composer dependencies, then http://localhost:8000/admin
#
# Running UnoPim rather than developing it? compose.yaml needs no .env at all —
# every setting there has a working default.
#
# Web server — Nginx (default) or Apache. For Apache, uncomment:
# COMPOSE_FILE=compose.dev.yaml:compose.dev.apache.yaml
#
# Database — PostgreSQL (default) or MySQL. See the COMPOSE_PROFILES /
# DB_CONNECTION block below; only the selected engine's container starts.
#
# These credentials are development defaults. Deployments inject their own.
# =============================================================================

APP_NAME=UnoPim
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Initial admin (used by AdminsTableSeeder on first boot only).
# Leave blank to auto-generate a random password and write it to
# storage/app/admin-credentials.txt — read it once, then delete.
# Existing admin rows are NEVER overwritten on re-seed.
INSTALLER_ADMIN_EMAIL=
INSTALLER_ADMIN_PASSWORD=

# IMPORTANT: If you change APP_PORT below, update this URL to match.
# Example: APP_PORT=8080 → APP_URL=http://localhost:8080
APP_URL=http://localhost:8000
APP_ADMIN_URL=admin
APP_TIMEZONE=UTC
APP_LOCALE=en_US
APP_CURRENCY=USD

# =============================================================================
# Database engine — PostgreSQL (default) or MySQL
# =============================================================================
# Change COMPOSE_PROFILES and the four DB_* lines together; only the selected
# engine's container is started.
#
#   MySQL:  COMPOSE_PROFILES=mysql
#           DB_CONNECTION=mysql
#           DB_HOST=unopim-mysql
#           DB_PORT=3306
#
# Switching engines on an existing install requires a fresh database — data is
# not migrated between them.
# =============================================================================
COMPOSE_PROFILES=pgsql

DB_CONNECTION=pgsql
DB_HOST=unopim-pgsql
DB_PORT=5432
DB_DATABASE=unopim
DB_USERNAME=unopim
DB_PASSWORD=password
DB_PREFIX=

# Cache (connects to unopim-redis service)
CACHE_STORE=redis
REDIS_HOST=unopim-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue (Redis for production performance)
QUEUE_CONNECTION=redis

# Mail (connects to unopim-mailpit service)
MAIL_MAILER=smtp
MAIL_HOST=unopim-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Elasticsearch (connects to unopim-elasticsearch service)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_CONNECTION=default
ELASTICSEARCH_HOST=unopim-elasticsearch:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_INDEX_PREFIX=unopim

# =============================================================================
# Docker Compose Settings
# =============================================================================
# FORWARD_* ports expose services to your host machine (localhost).
# They do NOT affect how services connect to each other inside Docker.
#
# If you get "port already in use" errors, change the conflicting port below.
# For example, if MySQL is already running locally on 3306:
#   FORWARD_DB_PORT=33060
#
# To find which ports are in use:
#   Linux:  ss -tlnp | grep <port>
#   macOS:  lsof -i :<port>
# =============================================================================

COMPOSE_PROJECT_NAME=unopim

# Host-side ports (change these if you have port conflicts)
APP_PORT=8000
FORWARD_PGSQL_PORT=5432
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_ES_PORT=9200
FORWARD_MAILPIT_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025

# MySQL root password (COMPOSE_PROFILES=mysql only; used at DB creation)
DB_ROOT_PASSWORD=password

# Elasticsearch disk watermarks (defaults suit development environments).
# If ES cluster goes RED due to disk space, raise these values further.
# For stricter production limits, lower these values (e.g. 85%, 90%, 95%).
# ELASTICSEARCH_DISK_WATERMARK_LOW=90%
# ELASTICSEARCH_DISK_WATERMARK_HIGH=95%
# ELASTICSEARCH_DISK_WATERMARK_FLOOD_STAGE=97%
